# Backblaze B2
B2_APPLICATION_KEY_ID="your-b2-application-key-id"
B2_APPLICATION_KEY="your-b2-application-key"

# Genblaze
GENBLAZE_API_KEY=""

# Providers used by the default Forge configuration
OPENAI_API_KEY="your-openai-api-key"
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
RUNWAY_API_KEY="your-runway-api-key"
# Some Runway SDK setups use this alternate variable name instead.
RUNWAYML_API_SECRET="your-runway-api-key"

# Qwen API (for standalone testing now; integrate into Forge routing later)
QWEN_API_KEY="your-qwen-api-key"
QWEN_BASE_URL="https://your-qwen-openai-compatible-endpoint/v1"
# If you want to route Forge's OpenAI provider through Qwen temporarily,
# set OPENAI_API_KEY to your Qwen key and configure your runtime to use
# QWEN_BASE_URL as the OpenAI-compatible base URL.

# Optional provider keys if you switch away from the defaults in forge/config.yaml
GOOGLE_API_KEY=""
ANTHROPIC_API_KEY=""
LUMA_API_KEY=""
STABILITY_API_KEY=""

# Voice placeholders for forge/config.yaml
ELEVENLABS_VOICE_ID_EN="EXAVITQu4vr4xnSDxMaL"
ELEVENLABS_VOICE_ID_HA="your-hausa-voice-id"
ELEVENLABS_VOICE_ID_YO="your-yoruba-voice-id"